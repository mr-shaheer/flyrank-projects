# Copy this file to .env and fill in what you have. Everything has a safe
# default / graceful fallback, so the app runs fully even with an empty .env.

# --- Database (SQLite by default, no setup needed) ---
DATABASE_URL=sqlite:///./jobradar.db

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM scoring (optional — falls back to a keyword-overlap scorer if unset) ---
# Get a free Gemini API key at https://aistudio.google.com/apikey
# Called via the OpenAI Agents SDK, using Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# --- Email digest (optional — skipped with a log message if unset) ---
# Example for Gmail: create an "app password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Scraper ---
SCRAPE_LIMIT=40

# --- Scheduler: hour (0-23, server time) the daily cycle runs ---
DAILY_RUN_HOUR=7

# --- Cache ---
JOB_LIST_CACHE_TTL_SECONDS=300

# --- Reports ---
REPORTS_DIR=./reports
